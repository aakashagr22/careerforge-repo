SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/careerforge
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-your-database-password
JWT_SECRET=replace-with-a-random-256-bit-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ==========================================================
# Email / Resend configuration (HTTPS API; compatible with Render free services)
# Create an API key at https://resend.com/api-keys and verify your sender domain.
# ==========================================================
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=CareerForge <noreply@your-verified-domain.com>
