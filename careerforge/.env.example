SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/careerforge
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-your-database-password
JWT_SECRET=replace-with-a-random-256-bit-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ==========================================================
# Email / SMTP Configuration (for real OTP delivery)
# For Gmail: generate an App Password in Google Account > Security > 2-Step Verification > App passwords
# ==========================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-character-google-app-password
